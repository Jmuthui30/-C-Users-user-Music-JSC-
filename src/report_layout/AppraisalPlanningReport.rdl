                                <TextRun>
                                  <Value>=IIf(Len(CStr(Fields!MeasureDescription.Value)) &gt; 0, "Measure / evidence: " &amp; Fields!MeasureDescription.Value, IIf(Len(CStr(Fields!InitiativeText.Value)) &gt; 0, "Activity / initiative: " &amp; Fields!InitiativeText.Value, IIf(Len(CStr(Fields!ResourceText.Value)) &gt; 0, "Resource / support: " &amp; Fields!ResourceText.Value, IIf(Len(CStr(Fields!MilestoneText.Value)) &gt; 0, "Quarterly milestone: " &amp; Fields!MilestoneText.Value, IIf(Len(CStr(Fields!HistoryAction.Value)) &gt; 0, Fields!HistoryAction.Value &amp; ": " &amp; Fields!HistoryReason.Value, "")))))</Value>
