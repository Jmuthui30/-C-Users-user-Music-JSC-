<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>F.O. 20 Payment Voucher</Description>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="DataSetDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString />
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="DataSet_Result">
      <Query>
        <DataSourceName>DataSetDataSource</DataSourceName>
        <CommandText />
      </Query>
      <Fields>
        <Field Name="No_"><DataField>No_</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Date_"><DataField>Date_</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="PaymentReleaseDate"><DataField>PaymentReleaseDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Payee"><DataField>Payee</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PaymentNarration"><DataField>PaymentNarration</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PayMode"><DataField>PayMode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PayingBankAccount"><DataField>PayingBankAccount</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ChequeNo"><DataField>ChequeNo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Currency"><DataField>Currency</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TotalAmount"><DataField>TotalAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalVATAmount"><DataField>TotalVATAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalWitholdingTaxAmount"><DataField>TotalWitholdingTaxAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalRetentionAmount"><DataField>TotalRetentionAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalNetAmount"><DataField>TotalNetAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="ShortcutDimension1Code"><DataField>ShortcutDimension1Code</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShortcutDimension2Code"><DataField>ShortcutDimension2Code</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AmountInWords"><DataField>AmountInWords</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CompanyName"><DataField>CompanyName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CompanyAddress"><DataField>CompanyAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CompanyCity"><DataField>CompanyCity</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LineNo"><DataField>LineNo</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="AccountNo"><DataField>AccountNo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AccountName"><DataField>AccountName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Description_"><DataField>Description_</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Amount_"><DataField>Amount_</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="VATAmount"><DataField>VATAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="WTaxAmount"><DataField>WTaxAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="RetentionAmount"><DataField>RetentionAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="NetAmount"><DataField>NetAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="LPONo"><DataField>LPONo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Dim1Code"><DataField>Dim1Code</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportSections>
    <ReportSection>
      <Page>
        <PageHeight>29.7cm</PageHeight>
        <PageWidth>21cm</PageWidth>
        <TopMargin>1cm</TopMargin>
        <BottomMargin>1cm</BottomMargin>
        <LeftMargin>1.5cm</LeftMargin>
        <RightMargin>1.5cm</RightMargin>


      <PageHeader>
        <Height>0cm</Height>
        <PrintOnFirstPage>false</PrintOnFirstPage>
        <PrintOnLastPage>false</PrintOnLastPage>
        <Style />
      </PageHeader>

      <PageFooter>
        <Height>0.5cm</Height>
        <PrintOnFirstPage>true</PrintOnFirstPage>
        <PrintOnLastPage>true</PrintOnLastPage>
        <ReportItems>
          <Textbox Name="PageNoFooter">
            <CanGrow>true</CanGrow>
            <Left>14cm</Left>
            <Width>4cm</Width>
            <Height>0.45cm</Height>
            <Paragraphs><Paragraph>
              <TextRuns><TextRun>
                <Value>=Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                <Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize></Style>
              </TextRun></TextRuns>
              <Style><TextAlign>Right</TextAlign></Style>
            </Paragraph></Paragraphs>
            <Style><VerticalAlign>Middle</VerticalAlign></Style>
          </Textbox>
          <Textbox Name="PrintedByFooter">
            <CanGrow>true</CanGrow>
            <Left>0cm</Left>
            <Width>12cm</Width>
            <Height>0.45cm</Height>
            <Paragraphs><Paragraph>
              <TextRuns><TextRun>
                <Value>="Printed: " &amp; Format(Now(),"dd/MM/yyyy HH:mm")</Value>
                <Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize></Style>
              </TextRun></TextRuns>
            </Paragraph></Paragraphs>
            <Style><VerticalAlign>Middle</VerticalAlign></Style>
          </Textbox>
        </ReportItems>
        <Style />
      </PageFooter>
      </Page>

      <Body>
        <Height>27cm</Height>
        <ReportItems>

          <Tablix Name="MainTablix">
            <DataSetName>DataSet_Result</DataSetName>
            <Left>0cm</Left>
            <Top>0cm</Top>
            <Width>18cm</Width>

            <TablixColumnHierarchy>
              <TablixMembers><TablixMember /></TablixMembers>
            </TablixColumnHierarchy>

            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember>
                  <Group Name="LinesDetailGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!LineNo.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                </TablixMember>
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
              </TablixMembers>
            </TablixRowHierarchy>

            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>18cm</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>

                <!-- ROW 1: Title bar -->
                <TablixRow>
                  <Height>0.7cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="TitleTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                            <TablixColumn><Width>12cm</Width></TablixColumn>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.7cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents>
                                  <Textbox Name="FormRef">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph><TextRuns><TextRun>
                                      <Value>F.O. 20 (REVISED)</Value>
                                      <Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize></Style>
                                    </TextRun></TextRuns></Paragraph></Paragraphs>
                                    <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                                      <Border><Style>Solid</Style><Width>0.5pt</Width></Border>
                                      <BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                                <TablixCell><CellContents>
                                  <Textbox Name="FormTitle">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph>
                                      <TextRuns><TextRun>
                                        <Value>PAYMENT VOUCHER  (VOTED PROVISION)</Value>
                                        <Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style>
                                      </TextRun></TextRuns>
                                      <Style><TextAlign>Center</TextAlign></Style>
                                    </Paragraph></Paragraphs>
                                    <Style><VerticalAlign>Middle</VerticalAlign>
                                      <Border><Style>Solid</Style><Width>0.5pt</Width></Border>
                                      <BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                                <TablixCell><CellContents>
                                  <Textbox Name="TitleFiller">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph><TextRuns><TextRun><Value> </Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs>
                                    <Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 2: Company / PV No / Dates -->
                <TablixRow>
                  <Height>1.6cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="HeaderTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>11cm</Width></TablixColumn>
                            <TablixColumn><Width>7cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.55cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents>
                                  <Textbox Name="CompanyNameTxt">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph><TextRuns><TextRun>
                                      <Value>=First(Fields!CompanyName.Value,"DataSet_Result")</Value>
                                      <Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight></Style>
                                    </TextRun></TextRuns></Paragraph></Paragraphs>
                                    <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                                      <Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                                <TablixCell><CellContents>
                                  <Textbox Name="PVNoRow">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph><TextRuns>
                                      <TextRun><Value>PV No:  </Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun>
                                      <TextRun><Value>=Fields!No_.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun>
                                    </TextRuns></Paragraph></Paragraphs>
                                    <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                                      <Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>0.55cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents>
                                  <Textbox Name="CompanyAddrTxt">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph><TextRuns><TextRun>
                                      <Value>=First(Fields!CompanyAddress.Value,"DataSet_Result") &amp; "  " &amp; First(Fields!CompanyCity.Value,"DataSet_Result")</Value>
                                      <Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style>
                                    </TextRun></TextRuns></Paragraph></Paragraphs>
                                    <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                                      <Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                                <TablixCell><CellContents>
                                  <Textbox Name="DateRow">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph><TextRuns>
                                      <TextRun><Value>Date:  </Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun>
                                      <TextRun><Value>=Format(Fields!Date_.Value,"dd/MM/yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun>
                                    </TextRuns></Paragraph></Paragraphs>
                                    <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                                      <Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>0.5cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents>
                                  <Textbox Name="FillerHdr">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph><TextRuns><TextRun><Value> </Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs>
                                    <Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                                <TablixCell><CellContents>
                                  <Textbox Name="PostingDateRow">
                                    <CanGrow>true</CanGrow>
                                    <Paragraphs><Paragraph><TextRuns>
                                      <TextRun><Value>Posting Date:  </Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun>
                                      <TextRun><Value>=Format(Fields!PaymentReleaseDate.Value,"dd/MM/yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun>
                                    </TextRuns></Paragraph></Paragraphs>
                                    <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                                      <Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                  </Textbox>
                                </CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 3: Payee / PayMode / Bank / Narration -->
                <TablixRow>
                  <Height>1.6cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="PayeeTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                            <TablixColumn><Width>5.5cm</Width></TablixColumn>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                            <TablixColumn><Width>6.5cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.55cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="PayeeLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Payee:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="PayeeVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Payee.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell />
                                <TablixCell />
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>0.55cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="PayModeLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Pay Mode:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="PayModeVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PayMode.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="BankLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Bank Account:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="BankVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PayingBankAccount.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>0.5cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="ChequeNoLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Cheque/Ref No:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="ChequeNoVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ChequeNo.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="NarrationLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Narration:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="NarrationVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PaymentNarration.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 4: Line items column headers -->
                <TablixRow>
                  <Height>0.6cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="ColHdrTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>6cm</Width></TablixColumn>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                            <TablixColumn><Width>2.5cm</Width></TablixColumn>
                            <TablixColumn><Width>2.2cm</Width></TablixColumn>
                            <TablixColumn><Width>2cm</Width></TablixColumn>
                            <TablixColumn><Width>2.3cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.6cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="HdrParticulars"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Particulars / Description</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#D0D0D0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="HdrAccount"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Vote / Acct No.</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#D0D0D0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="HdrLPO"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>LPO/LSO No.</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#D0D0D0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="HdrGross"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Gross Amt (Kshs)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#D0D0D0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="HdrWTax"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>W/Tax</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#D0D0D0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="HdrNet"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Net Amt (Kshs)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#D0D0D0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 5: Detail lines (one per Payment Line) -->
                <TablixRow>
                  <Height>0.5cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="LinesTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy>
                          <TablixMembers>
                            <TablixMember>
                              <Group Name="LineDetailGroup">
                                <GroupExpressions>
                                  <GroupExpression>=Fields!LineNo.Value</GroupExpression>
                                </GroupExpressions>
                              </Group>
                            </TablixMember>
                          </TablixMembers>
                        </TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>6cm</Width></TablixColumn>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                            <TablixColumn><Width>2.5cm</Width></TablixColumn>
                            <TablixColumn><Width>2.2cm</Width></TablixColumn>
                            <TablixColumn><Width>2cm</Width></TablixColumn>
                            <TablixColumn><Width>2.3cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.5cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="LineDesc"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Description_.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.25pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="LineAcct"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AccountNo.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.25pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="LineLPO"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!LPONo.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.25pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="LineGross"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Amount_.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><Format>#,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight><Border><Style>Solid</Style><Width>0.25pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="LineWTax"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!WTaxAmount.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><Format>#,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight><Border><Style>Solid</Style><Width>0.25pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="LineNet"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!NetAmount.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><Format>#,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight><Border><Style>Solid</Style><Width>0.25pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 6: Totals -->
                <TablixRow>
                  <Height>0.55cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="TotalsTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>6cm</Width></TablixColumn>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                            <TablixColumn><Width>2.5cm</Width></TablixColumn>
                            <TablixColumn><Width>2.2cm</Width></TablixColumn>
                            <TablixColumn><Width>2cm</Width></TablixColumn>
                            <TablixColumn><Width>2.3cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.55cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="TotalLabel"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>TOTAL</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingRight>4pt</PaddingRight><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#E0E0E0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell />
                                <TablixCell />
                                <TablixCell><CellContents><Textbox Name="TotGross"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!TotalAmount.Value,"DataSet_Result")</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Format>#,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#E0E0E0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="TotWTax"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!TotalWitholdingTaxAmount.Value,"DataSet_Result")</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Format>#,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#E0E0E0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="TotNet"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!TotalNetAmount.Value,"DataSet_Result")</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Format>#,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#E0E0E0</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 7: Amount in words -->
                <TablixRow>
                  <Height>0.6cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="AmtWordsTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>6.5cm</Width></TablixColumn>
                            <TablixColumn><Width>11.5cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.6cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="AmtWordsLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Amount Payable (in words): Shillings:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AmtWordsVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!AmountInWords.Value,"DataSet_Result")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontStyle>Italic</FontStyle></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 8: Examination / Internal Audit / Authorisation -->
                <TablixRow>
                  <Height>2cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="SigTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>6cm</Width></TablixColumn>
                            <TablixColumn><Width>6cm</Width></TablixColumn>
                            <TablixColumn><Width>6cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.4cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="ExamHdr"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>EXAMINATION</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#EEEEEE</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AuditHdr"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Internal Audit</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#EEEEEE</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AuthHdr"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>AUTHORIZATION</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#EEEEEE</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>1.6cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="ExamBody"><CanGrow>true</CanGrow>
                                  <Paragraphs>
                                    <Paragraph><TextRuns><TextRun><Value>Voucher Examined by.........................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Date .................................................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                  </Paragraphs>
                                  <Style><PaddingLeft>4pt</PaddingLeft><PaddingTop>4pt</PaddingTop><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AuditBody"><CanGrow>true</CanGrow>
                                  <Paragraphs>
                                    <Paragraph><TextRuns><TextRun><Value>Signature..........................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Date ............................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Designation .........................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                  </Paragraphs>
                                  <Style><PaddingLeft>4pt</PaddingLeft><PaddingTop>4pt</PaddingTop><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AuthBody"><CanGrow>true</CanGrow>
                                  <Paragraphs>
                                    <Paragraph><TextRuns><TextRun><Value>Signature............................................................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Accounting Officer / District Accountant</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Date.................................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                  </Paragraphs>
                                  <Style><PaddingLeft>4pt</PaddingLeft><PaddingTop>4pt</PaddingTop><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 9: VBC / AIE Certificates -->
                <TablixRow>
                  <Height>3.2cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="CertTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>9cm</Width></TablixColumn>
                            <TablixColumn><Width>9cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.4cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="VBCHdr"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>VBC CERTIFICATE</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#EEEEEE</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AIEHdr"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>AIE HOLDER CERTIFICATE</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#EEEEEE</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>2.8cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="VBCBody"><CanGrow>true</CanGrow>
                                  <Paragraphs>
                                    <Paragraph><TextRuns><TextRun><Value>I certify that the expenditure has been entered in the Vote Book and that adequate funds to cover it are available against the chargeable Item as shown here below:-</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value> </Value><Style><FontFamily>Arial</FontFamily><FontSize>4pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Approved Estimates/Allocation:- Item No............. Kshs......................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Less: Total expenditure + commitments Kshs......................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Balance Kshs....................  Less: This ENTRY Kshs....................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Balance - Kshs..................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value> </Value><Style><FontFamily>Arial</FontFamily><FontSize>4pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Date .......................  Signature................................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Accountant i/c VBC</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                  </Paragraphs>
                                  <Style><PaddingLeft>4pt</PaddingLeft><PaddingTop>3pt</PaddingTop><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AIEBody"><CanGrow>true</CanGrow>
                                  <Paragraphs>
                                    <Paragraph><TextRuns><TextRun><Value>I certify that the expenditure detailed above has been incurred for the authorized purpose and should be charged to the Item shown here below:-</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value> </Value><Style><FontFamily>Arial</FontFamily><FontSize>4pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Signature.......................................  .................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Designation of AIE Holder</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value> </Value><Style><FontFamily>Arial</FontFamily><FontSize>4pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                    <Paragraph><TextRuns><TextRun><Value>Date.............................</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns></Paragraph>
                                  </Paragraphs>
                                  <Style><PaddingLeft>4pt</PaddingLeft><PaddingTop>3pt</PaddingTop><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 10: Vote Head coding -->
                <TablixRow>
                  <Height>1.4cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="CodingTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                            <TablixColumn><Width>2cm</Width></TablixColumn>
                            <TablixColumn><Width>2.5cm</Width></TablixColumn>
                            <TablixColumn><Width>2.5cm</Width></TablixColumn>
                            <TablixColumn><Width>2cm</Width></TablixColumn>
                            <TablixColumn><Width>3cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.45cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="VoteHdLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Vote Head</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="SubHdLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Sub-Head</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="ItemLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Item</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AIENoLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>A.I.E No.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AcctNoLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Account No.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="StationLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Station</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="CashBkLbl"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Cash Book Amount</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DDDDDD</BackgroundColor></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>0.95cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="VoteHdVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!ShortcutDimension1Code.Value,"DataSet_Result")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="SubHdVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!ShortcutDimension2Code.Value,"DataSet_Result")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="ItemVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value> </Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AIENoVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value> </Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="AcctNoVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!No_.Value,"DataSet_Result")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="StationVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value> </Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="CashBkVal"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!TotalNetAmount.Value,"DataSet_Result")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Format>#,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- ROW 11: Receipt / Signature -->
                <TablixRow>
                  <Height>2cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Tablix Name="ReceiptTablix">
                        <DataSetName>DataSet_Result</DataSetName>
                        <Width>18cm</Width>
                        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
                        <TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy>
                        <TablixBody>
                          <TablixColumns>
                            <TablixColumn><Width>9cm</Width></TablixColumn>
                            <TablixColumn><Width>9cm</Width></TablixColumn>
                          </TablixColumns>
                          <TablixRows>
                            <TablixRow>
                              <Height>0.35cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="ReceiptNote"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Receipt not required when payment is made by cheque with form of receipt on reverse.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontStyle>Italic</FontStyle></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell />
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>0.35cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="ReceivedTxt"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Received in payment of the account stated on the face hereof the sum of</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell />
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>0.4cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="SumLabel"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Sh...................................................... Cts.................................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="WitnessLabel"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Witness............................................</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                            <TablixRow>
                              <Height>0.9cm</Height>
                              <TablixCells>
                                <TablixCell><CellContents><Textbox Name="SumWords"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>=First(Fields!AmountInWords.Value,"DataSet_Result")</Value>
                                    <Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontStyle>Italic</FontStyle></Style>
                                  </TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                                <TablixCell><CellContents><Textbox Name="SignatureLine"><CanGrow>true</CanGrow>
                                  <Paragraphs><Paragraph><TextRuns><TextRun><Value>Date.........................................  Signature or Thumbprint</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingBottom>4pt</PaddingBottom><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                                </Textbox></CellContents></TablixCell>
                              </TablixCells>
                            </TablixRow>
                          </TablixRows>
                        </TablixBody>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Tablix>
                    </CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>
            <Style><Border><Style>None</Style></Border></Style>
          </Tablix>

        </ReportItems>
        <Style />
      </Body>
      <Width>18cm</Width>

    </ReportSection>
  </ReportSections>

  <rd:ReportUnitType>Cm</rd:ReportUnitType>
</Report>
